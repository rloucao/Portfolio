## Client — shipped to the browser, public by design
# -------------------------------------------------------------
# Cloudflare Turnstile site key.
# Currently the Cloudflare "always passes" TEST key so local dev works.
# Replace with your real site key from the Turnstile dashboard.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEjOJg4uTX90VemS
# -------------------------------------------------------------

## Server — used only by api/contact.js. NEVER prefix these with VITE_,
## that would publish them in the client bundle.
# -------------------------------------------------------------
# Cloudflare "always passes" TEST secret — replace with the real one.
TURNSTILE_SECRET_KEY=0x4AAAAAAEjOJpNrf5tRylIs0590w9UWl0A

EMAILJS_PUBLIC_KEY=qQqmGLJ6r94-qGA1z
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=service_igq3bsi
EMAILJS_TEMPLATE_ID=template_0gu5o7p
# -------------------------------------------------------------
