## Client — shipped to the browser, public by design
# -------------------------------------------------------------
# Cloudflare Turnstile site key.
VITE_TURNSTILE_SITE_KEY=
# -------------------------------------------------------------

## Server — used only by api/contact.js. NEVER prefix these with VITE_,
## that would publish them in the client bundle.
# -------------------------------------------------------------
TURNSTILE_SECRET_KEY=

RESEND_API_KEY=
# Until rloucao.dev is verified in Resend, leave MAIL_FROM unset and the
# handler falls back to onboarding@resend.dev (delivers only to your own
# Resend account address). After verifying: Portfolio <hello@rloucao.dev>
MAIL_FROM=
MAIL_TO=
# -------------------------------------------------------------
